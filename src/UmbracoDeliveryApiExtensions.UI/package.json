{
  "name": "delivery-api-extensions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --base /",
    "dev:clean": "vite --force --base /",
    "build": "tsc && vite build",
    "watch": "chokidar src public -c \"tsc && vite build\" --initial",
    "clean": "node -e \"['dist', 'obj', 'node_modules'].forEach(f => require('node:fs').rmSync(f, { recursive: true, force: true }))\"",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@lit/context": "^1.1.3",
    "@lit/task": "^1.0.1",
    "@r2wc/react-to-web-component": "^2.0.3",
    "@uiw/react-json-view": "^2.0.0-alpha.30",
    "@umbraco-ui/uui": "^1.11.0",
    "js-cookie": "^3.0.5",
    "lit": "^3.2.1",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@types/angular": "^1.8.9",
    "@types/angular-route": "^1.7.6",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.14.0",
    "eslint-config-xo-space": "^0.35.0",
    "eslint-config-xo-typescript": "^7.0.0",
    "eslint-plugin-lit": "^1.15.0",
    "eslint-plugin-lit-a11y": "^4.1.4",
    "eslint-plugin-n": "^17.13.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-wc": "^2.2.0",
    "patch-package": "^8.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "volta": {
    "node": "22.11.0"
  }
}
