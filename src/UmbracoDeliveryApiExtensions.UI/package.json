{
  "name": "delivery-api-extensions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --base /",
    "dev:clean": "vite --force --base /",
    "build": "tsc && vite build",
    "watch": "chokidar src public -c \"tsc && vite build\" --initial",
    "clean": "node -e \"['dist', 'obj', 'node_modules'].forEach(f => require('node:fs').rmSync(f, { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@r2wc/react-to-web-component": "^2.1.0",
    "@uiw/react-json-view": "^2.0.0-alpha.39",
    "lit": "^3.3.1",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.26",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@umbraco-cms/backoffice": "^17.0.0-rc1",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.0",
    "eslint-config-xo-space": "^0.35.0",
    "eslint-config-xo-typescript": "^9.0.0",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-wc": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "volta": {
    "node": "22.21.1",
    "npm": "11.6.2"
  }
}
