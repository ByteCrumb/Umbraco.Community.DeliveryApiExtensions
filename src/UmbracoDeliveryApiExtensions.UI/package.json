{
  "name": "delivery-api-extensions",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --base /",
    "dev:clean": "vite --force --base /",
    "build": "tsc && vite build",
    "watch": "chokidar src public -c \"tsc && vite build\" --initial",
    "clean": "node -e \"['dist', 'obj', 'node_modules'].forEach(f => require('node:fs').rmSync(f, { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@lit/context": "^1.1.5",
    "@lit/task": "^1.0.2",
    "@r2wc/react-to-web-component": "^2.0.4",
    "@uiw/react-json-view": "^2.0.0-alpha.32",
    "lit": "^3.3.0",
    "preact": "^10.26.9"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@umbraco-cms/backoffice": "^16.0.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.28.0",
    "eslint-config-xo-space": "^0.35.0",
    "eslint-config-xo-typescript": "^8.0.1",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-lit-a11y": "^5.0.1",
    "eslint-plugin-n": "^17.19.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-wc": "^3.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.1"
  },
  "volta": {
    "node": "22.16.0",
    "npm": "11.4.1"
  }
}
