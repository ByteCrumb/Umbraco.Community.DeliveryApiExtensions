{
  "name": "delivery-api-extensions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --base /",
    "dev:clean": "vite --force --base /",
    "build": "tsc && vite build",
    "watch": "chokidar src public -c \"tsc && vite build\" --initial",
    "clean": "node -e \"['dist', 'obj', 'node_modules'].forEach(f => require('node:fs').rmSync(f, { recursive: true, force: true }))\""
  },
  "dependencies": {
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@r2wc/react-to-web-component": "^2.1.1",
    "@uiw/react-json-view": "2.0.0-alpha.32",
    "lit": "^3.3.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^18.3.31",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@umbraco-cms/backoffice": "^18.0.0",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-config-xo-space": "^1.0.0",
    "eslint-config-xo-typescript": "^11.0.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-wc": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.21.0"
  }
}
