{
  "name": "openapi-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "openapi-typescript",
  "main": "dist/app.js",
  "scripts": {
    "start": "npm run generate-api-client && npm run build && node dist/app.js",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "generate-api-client": "openapi-typescript ../../UmbracoDeliveryApiExtensions.TestSite/delivery.swagger.g.json -o ./api/umbraco-api.d.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "eslint-config-xo-space": "^0.35.0",
    "eslint-config-xo-typescript": "^8.0.1",
    "eslint-plugin-n": "^17.19.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "openapi-typescript": "^6.7.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.0"
  },
  "volta": {
    "node": "22.16.0"
  }
}
