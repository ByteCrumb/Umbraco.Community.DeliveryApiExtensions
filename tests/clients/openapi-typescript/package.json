{
  "name": "openapi-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "openapi-typescript",
  "main": "dist/app.js",
  "scripts": {
    "start": "npm run generate-api-client && npm run build && node dist/app.js",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "generate-api-client": "openapi-typescript ../../UmbracoDeliveryApiExtensions.TestSite/delivery.swagger.g.json -o ./api/umbraco-api.d.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-xo-space": "^1.0.0",
    "eslint-config-xo-typescript": "^11.0.0",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "openapi-typescript": "^6.7.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.16.0"
  }
}
