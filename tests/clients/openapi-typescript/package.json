{
  "name": "openapi-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "openapi-typescript",
  "main": "dist/app.js",
  "scripts": {
    "start": "npm run generate-api-client && npm run build && node dist/app.js",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "generate-api-client": "openapi-typescript ../../UmbracoDeliveryApiExtensions.TestSite/delivery.swagger.g.json -o ./api/umbraco-api.d.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.53.0",
    "eslint-config-xo-space": "^0.35.0",
    "eslint-config-xo-typescript": "^1.0.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "openapi-typescript": "^6.7.6",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "volta": {
    "node": "20.9.0"
  }
}
